DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-1-eu-west-3.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_BUCKET=showcase-images
# Service role key for bucket writes. Required for POST /api/publish.
# Get it from Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret for verifying Supabase Auth tokens.
# Supabase dashboard → Project Settings → API → JWT Settings → JWT Secret.
SUPABASE_JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://showcase.x22.fr,https://showcase-omega-jade.vercel.app

# FIX650: set to 1 ONLY for the local-app deployment (never in production/Render).
# Drops the login requirement — unauthenticated requests resolve to the trusted
# local admin instead of anonymous.
LOCAL_APP=

# Cloudflare R2 (S3-compatible) — image file storage. DB + auth stay on Supabase.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=showcase-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public read base (bucket's r2.dev URL or a custom domain), no trailing slash.
R2_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev
